# ─────────────────────────────────────────────────────────────
# 你設哪個模型，JRcode 就一直用哪個。
# 系統不會在面試進行到一半自動幫你換模型——額度用完時會直接告訴你，
# 由你決定要等額度重置、換模型、還是改用本機自架模型。
# ─────────────────────────────────────────────────────────────

# ── 選項 A（預設）：Gemini 免費額度 ────────────────────────────
# 到 https://aistudio.google.com/apikey 免費申請，貼在這裡就能用。
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# 選填：讓「沉默觀察引擎」用另一顆更便宜的模型做判斷，把主模型的額度留給對話。
# 不設定就跟主模型用同一顆——本機模型通常只跑一個模型，維持不設定即可。
# OBSERVER_MODEL=gemini-2.5-flash-lite

# ── 選項 B：本機自架模型（免費、私密、不限流量）────────────────
# 照 local-llm/README.md 裝好 Ollama 後，改成下面兩行即可（LLM_API_KEY 留空沒關係）：
#LLM_API_KEY=ollama
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=qwen3-coder:30b
#LLM_FALLBACK_MODELS=
# OBSERVER_MODEL=qwen3-coder:30b

# ── 選項 C：你自己的其他供應商 ────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=...

# 面試官語音（Edge TTS，免費免 key）。其他選擇：
# zh-TW-YunJheNeural（台灣男聲）、zh-TW-HsiaoYuNeural（台灣女聲）、zh-CN-XiaoxiaoNeural（大陸女聲）
TTS_VOICE=zh-TW-HsiaoChenNeural

# 伺服器埠號
PORT=3001
