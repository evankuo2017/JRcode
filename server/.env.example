# 你設哪個模型，JRcode 就一直用哪個——系統不會在面試中途自動換模型。

# ── 選項 A（預設）：Gemini 免費額度 ────────────────────────────
# 到 https://aistudio.google.com/apikey 免費申請
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# ── 選項 B：自架模型（見 local-llm/README.md）──────────────────
# 同一台：
# LLM_BASE_URL=http://localhost:11434/v1
# 另一台（區網 IP，或 VS Code 埠轉發後的 localhost:埠號）：
# LLM_BASE_URL=http://192.168.1.50:11434/v1
# LLM_MODEL=qwen3-coder:30b

# ── 選項 C：其他供應商 ────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=...

# 選填：觀察引擎專用的便宜模型，省主模型額度。不設定＝跟主模型同一顆。
# OBSERVER_MODEL=gemini-2.5-flash-lite

# 面試官語音（Edge TTS，免費免 key）。其他：
# zh-TW-YunJheNeural（男聲）、zh-TW-HsiaoYuNeural（女聲）、zh-CN-XiaoxiaoNeural（大陸女聲）
TTS_VOICE=zh-TW-HsiaoChenNeural

PORT=3001
