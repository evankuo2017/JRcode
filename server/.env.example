# 必填：你的 Gemini API key（到 https://aistudio.google.com/apikey 免費申請）
LLM_API_KEY=

# 以下皆為選填，預設走 Gemini 的 OpenAI 相容端點
# 換成其他供應商（Groq / OpenRouter / Ollama...）只需改這兩行：
# LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=llama3.1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# 面試官語音（Edge TTS，免費免 key）。其他選擇：
# zh-TW-YunJheNeural（台灣男聲）、zh-TW-HsiaoYuNeural（台灣女聲）、zh-CN-XiaoxiaoNeural（大陸女聲）
TTS_VOICE=zh-TW-HsiaoChenNeural

# 伺服器埠號
PORT=3001
